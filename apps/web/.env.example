# Where the NestJS API listens. Only used on the server (Next.js forwards /api/* to it).
API_URL="http://127.0.0.1:4000"

# Production only (leave empty locally): must equal PROXY_SECRET in the API. Lets the API tell visitors apart.
PROXY_SECRET=""

# Contact form: a Gmail address and its app password. Messages from the Contact page are sent to this inbox. Server only.
EMAIL_USER=""
EMAIL_PASS=""
