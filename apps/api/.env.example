# Copy this file to .env and fill in the values. Never commit .env.
DATABASE_URL="postgresql://relgari:relgari_dev@127.0.0.1:5433/relgari"

# Two different random 32-byte secrets, base64 encoded. Make each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NID_ENCRYPTION_KEY: encrypts NIDs so they can be shown to their owner. Back it up: without it stored NIDs cannot be read.
NID_ENCRYPTION_KEY=""
# NID_HASH_SECRET: keyed hash that detects a repeated NID. Changing it later breaks that duplicate check.
NID_HASH_SECRET=""

PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Production only (leave empty locally): a random secret shared with the website, so the API can tell
# visitors apart behind it. The website must have the same value. Make one with the node command above.
PROXY_SECRET=""
# Secret ending of the uptime-monitor address: GET /ping/<this>. Letters, digits, - and _ (16+). Remove the line to switch the route off.
HEALTH_TOKEN=
