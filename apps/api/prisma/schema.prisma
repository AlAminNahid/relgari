// Relgari database. Tables are added one feature at a time.
// Feature 1 (login and registration): users and sessions.
// Feature 2 (the railway itself): stations, trains, train stops, coaches and seats.
// Feature 3 (ticket search): how many seats of a train each boarding station may sell.
// Feature 4 (seat map): holds, the seats a person is holding while they decide.
// Feature 5 (payment): bookings, the seats a person has paid for.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(uuid(7))
  name  String
  phone String @unique // always stored as 01XXXXXXXXX

  // The NID is never stored as plain text.
  // nidHash is a keyed hash: lets us reject a second account with the same NID without being able to read it.
  // nidEncrypted is AES-256-GCM: only the server can decrypt it, to show the NID to its owner.
  nidHash      String @unique @map("nid_hash")
  nidEncrypted String @map("nid_encrypted")

  passwordHash String   @map("password_hash") // argon2id
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions Session[]
  holds    Hold[]
  bookings Booking[]

  @@map("users")
}

// One row per signed-in browser. The cookie holds a random token; only its SHA-256 hash is stored here,
// so a copy of this table cannot be used to sign in.
model Session {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// The names match the class keys the website uses. `ac` is the AC cabin (a berth at night) and
// `acs` is the AC seat (the same sofas used as seats by day). Shovan is kept for later: no intercity
// train sells it, so nothing in the seed uses it.
enum SeatClass {
  shovan
  schair
  snigdha
  ac
  acs

  @@map("seat_class")
}

model Station {
  id     String @id @default(uuid(7))
  code   String @unique // short code shown on tickets, e.g. DAC
  nameEn String @map("name_en")
  nameBn String @map("name_bn")

  stops        TrainStop[]
  quotas       StationQuota[]
  holdsFrom    Hold[]         @relation("HoldFrom")
  holdsTo      Hold[]         @relation("HoldTo")
  bookingsFrom Booking[]      @relation("BookingFrom")
  bookingsTo   Booking[]      @relation("BookingTo")

  @@map("stations")
}

model Train {
  id     String @id @default(uuid(7))
  number Int    @unique // the public train number, e.g. 701
  nameEn String @map("name_en")
  nameBn String @map("name_bn")
  // The weekday the train does not run: 0 is Sunday, 6 is Saturday. Empty means it runs every day.
  offDay Int?   @map("off_day")

  stops    TrainStop[]
  coaches  Coach[]
  quotas   StationQuota[]
  holds    Hold[]
  bookings Booking[]

  @@map("trains")
}

// One row per station a train calls at, in order. A journey is any earlier stop to any later stop.
model TrainStop {
  id        String @id @default(uuid(7))
  trainId   String @map("train_id")
  stationId String @map("station_id")
  sequence  Int // 1 is the first station

  // Minutes after midnight of the day the train starts. 1440 or more means the next day,
  // so an overnight train needs no separate date column.
  arrivalMinute   Int? @map("arrival_minute") // empty at the first station
  departureMinute Int? @map("departure_minute") // empty at the last station

  distanceKm Int @map("distance_km") // from the first station; fares are worked out from this

  train   Train   @relation(fields: [trainId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id])

  @@unique([trainId, sequence])
  @@unique([trainId, stationId])
  @@index([stationId])
  @@map("train_stops")
}

model Coach {
  id          String    @id @default(uuid(7))
  trainId     String    @map("train_id")
  code        String // printed on the coach and the ticket, e.g. KA
  seatClass   SeatClass @map("seat_class")
  position    Int // 1 is the coach right behind the engine
  rows        Int
  seatsPerRow Int       @map("seats_per_row")

  train  Train   @relation(fields: [trainId], references: [id], onDelete: Cascade)
  seats  Seat[]
  cabins Cabin[]

  @@unique([trainId, code])
  @@unique([trainId, position])
  @@map("coaches")
}

// A cabin of an AC coach. Each sofa seats 3 people by day (rows are counted in sofas, 3 seats each)
// and is 2 berths by night (the sofa and an upper berth above it). Cabins have 1 or 2 sofas. Cabins are only stored for AC coaches.
model Cabin {
  id      String @id @default(uuid(7))
  coachId String @map("coach_id")
  number  Int // 1 is the cabin nearest the front of the coach
  sofas   Int // 1 or 2

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, number])
  @@map("cabins")
}

// Seats are stored once per coach, not once per day. Whether a seat is free on a date comes from
// the holds (and later the bookings) for that run of the train.
model Seat {
  id      String   @id @default(uuid(7))
  coachId String   @map("coach_id")
  kind    SeatKind @default(seat)
  number  Int // counted row by row, starting at 1. Seats and berths are numbered separately.
  // AC coaches only: the sofa this seat or berth belongs to, counted from the front of the coach.
  // A sofa is either 3 seats (by day) or 2 berths (by night), never both at once.
  sofa    Int?

  coach    Coach         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  holds    Hold[]
  bookedAs BookingSeat[]

  @@unique([coachId, kind, number])
  @@map("seats")
}

// A seat, or a berth of an AC coach. Berths are sold as AC Cabin, AC coach seats as AC Seat.
enum SeatKind {
  seat
  berth

  @@map("seat_kind")
}

// A person holding one seat for a few minutes while they decide. Each seat has its own timer.
// A hold belongs to a run of the train, named by the day the train sets off (runDate), not the
// day the passenger boards: on an overnight train those can differ, and the seat is the same.
// A person holds at most 4 seats at once, and all of them are on one journey.
model Hold {
  id            String    @id @default(uuid(7))
  userId        String    @map("user_id")
  trainId       String    @map("train_id")
  runDate       DateTime  @map("run_date") @db.Date
  seatId        String    @map("seat_id")
  seatClass     SeatClass @map("seat_class") // what the passenger bought: schair, snigdha, acs or ac
  fromStationId String    @map("from_station_id")
  toStationId   String    @map("to_station_id")
  fare          Int
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime  @map("expires_at")

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  train       Train   @relation(fields: [trainId], references: [id], onDelete: Cascade)
  seat        Seat    @relation(fields: [seatId], references: [id], onDelete: Cascade)
  fromStation Station @relation("HoldFrom", fields: [fromStationId], references: [id])
  toStation   Station @relation("HoldTo", fields: [toStationId], references: [id])

  // One hold per seat per run. An expired row is removed before the seat is held again.
  @@unique([seatId, runDate])
  @@index([userId])
  @@index([trainId, runDate])
  @@index([expiresAt])
  @@map("holds")
}

// A train's seats are shared out between the stations people board at: a busy station gets more.
// One row says how many seats of one class a station may sell on that train, for any journey date.
// For each train and class the rows add up to the seats that class has on the train.
model StationQuota {
  id        String    @id @default(uuid(7))
  trainId   String    @map("train_id")
  stationId String    @map("station_id")
  seatClass SeatClass @map("seat_class")
  seats     Int

  train   Train   @relation(fields: [trainId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([trainId, stationId, seatClass])
  @@index([stationId])
  @@map("station_quotas")
}

// How a booking was paid. The payment itself is a pretend gateway: no money moves.
enum PaymentMethod {
  bkash
  nagad
  rocket
  card

  @@map("payment_method")
}

// One paid order: the seats a person bought on one journey, with the payment that bought them.
// Created at the moment the pretend payment succeeds, from the seats the person was holding.
model Booking {
  id            String        @id @default(uuid(7))
  pnr           String        @unique // the short code printed on the ticket, e.g. RG4K7MX2
  userId        String        @map("user_id")
  trainId       String        @map("train_id")
  runDate       DateTime      @map("run_date") @db.Date // the day the train sets off
  fromStationId String        @map("from_station_id")
  toStationId   String        @map("to_station_id")
  paymentMethod PaymentMethod @map("payment_method")
  transactionId String        @unique @map("transaction_id")
  subtotal      Int // the fares of all the seats
  serviceCharge Int           @map("service_charge")
  total         Int
  createdAt     DateTime      @default(now()) @map("created_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  train       Train         @relation(fields: [trainId], references: [id])
  fromStation Station       @relation("BookingFrom", fields: [fromStationId], references: [id])
  toStation   Station       @relation("BookingTo", fields: [toStationId], references: [id])
  seats       BookingSeat[]

  @@index([userId])
  @@map("bookings")
}

// One seat of a booking. The train, run date, class and boarding station are copied from the
// booking so "how many seats are taken" is a single table lookup, the same as for holds.
model BookingSeat {
  id            String    @id @default(uuid(7))
  bookingId     String    @map("booking_id")
  seatId        String    @map("seat_id")
  trainId       String    @map("train_id")
  runDate       DateTime  @map("run_date") @db.Date
  seatClass     SeatClass @map("seat_class")
  fromStationId String    @map("from_station_id")
  fare          Int

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    Seat    @relation(fields: [seatId], references: [id])

  // A seat can be sold once per run of the train.
  @@unique([seatId, runDate])
  @@index([trainId, runDate])
  @@index([bookingId])
  @@map("booking_seats")
}
